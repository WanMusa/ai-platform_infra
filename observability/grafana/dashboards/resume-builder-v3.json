{
  "uid": "resume-builder-v3",
  "title": "Resume Builder V3",
  "tags": ["application", "resume-builder-v3"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "V3 service logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "{app=\"resume-builder-v3\"}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Failed attempts per 5 minutes",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "sum(count_over_time({app=\"resume-builder-v3\"} | json | event=\"job.attempt_failed\" [5m]))",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] },
      "options": {
        "legend": { "showLegend": false },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    }
  ]
}